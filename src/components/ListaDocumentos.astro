---
import { formatearFecha } from '../lib/fechas';
import { agruparPorAnio, formatearTamano, type Documento } from '../lib/documentos';
import Enlace from './Enlace.astro';

interface Props {
	documentos: Documento[];
	/** Nivel del título de cada año: 2 en una página de sección, 3 si va debajo de otro h2 */
	nivel?: 2 | 3;
}

const { documentos, nivel = 2 } = Astro.props;
const TituloAnio = nivel === 3 ? 'h3' : 'h2';
const grupos = agruparPorAnio(documentos);
---

{
	grupos.map(([anio, docs]) => (
		// data-pagefind-ignore: cada documento ya entra al índice como registro propio
		// (src/lib/busqueda.ts). Si también se indexara acá, aparecería dos veces.
		<section class="anio" aria-labelledby={`anio-${anio}`} data-pagefind-ignore>
			<TituloAnio class="anio__titulo" id={`anio-${anio}`}>
				{anio}
			</TituloAnio>
			<ul class="documentos">
				{docs.map((doc) => (
					<li class="documento">
						{/* El formato y el tamaño van DENTRO del link: el lector de pantalla
						    anuncia qué se va a abrir antes de hacer clic (WCAG 2.4.4) */}
						<Enlace class="documento__titulo" href={doc.url}>
							{doc.titulo}{' '}
							<span class="documento__archivo">(PDF, {formatearTamano(doc.bytes)})</span>
						</Enlace>
						{doc.descripcion && <p class="documento__descripcion">{doc.descripcion}</p>}
						<p class="documento__meta">
							<span>{doc.tipo}</span>
							<span>
								<time datetime={doc.fecha}>{formatearFecha(doc.fecha)}</time>
							</span>
							{doc.expediente && <span>Expte. {doc.expediente}</span>}
						</p>
					</li>
				))}
			</ul>
		</section>
	))
}
