---
import Base from '../layouts/Base.astro';
import FormularioSolicitud from '../components/FormularioSolicitud.astro';
import ListaDocumentos from '../components/ListaDocumentos.astro';
import Pendiente from '../components/Pendiente.astro';
import { secciones } from '../data/secciones';
import { accesoInformacion as datos, datosPendientes } from '../data/acceso-informacion';
import { contenidoDeSeccion } from '../lib/documentos';

const SLUG = 'acceso-a-la-informacion';
const seccion = secciones.find((s) => s.slug === SLUG)!;
const { documentos } = await contenidoDeSeccion(SLUG);

// Nunca publicar datos institucionales inventados: el build de producción falla
// mientras falte alguno. Para revisar en staging: PERMITIR_PENDIENTES=1.
const pendientes = datosPendientes();
if (import.meta.env.PROD && pendientes.length > 0 && process.env.PERMITIR_PENDIENTES !== '1') {
	throw new Error(
		`La página de acceso a la información tiene datos pendientes: ${pendientes.join('; ')}. ` +
			'Completarlos en src/data/acceso-informacion.ts (guía: docs/acceso-a-la-informacion.md).',
	);
}
---

<Base titulo={seccion.titulo} descripcion={seccion.descripcion} slugActivo={SLUG}>
	<p class="migas">
		<a href="/">Inicio</a>
		<span aria-hidden="true">›</span>
		<span>{seccion.titulo}</span>
	</p>

	{
		pendientes.length > 0 && (
			<div class="aviso aviso--pendientes" role="note">
				<strong>Versión de revisión: faltan {pendientes.length} datos de Legal y Técnica.</strong>
				<ul>
					{pendientes.map((pendiente) => (
						<li>{pendiente}</li>
					))}
				</ul>
			</div>
		)
	}

	<div class="texto-lectura">
		<h1>{seccion.titulo}</h1>
		<p class="bajada">
			Si la información que buscás no está publicada en este portal, podés pedírsela a la Universidad. Es un derecho
			garantizado por la <strong>Ley 27.275</strong>.
		</p>
	</div>

	<!-- Lo primero que la persona necesita saber, antes de decidir si hace la solicitud -->
	<ul class="claves" aria-label="Lo que tenés que saber antes de pedir información">
		<li class="clave">
			<h2 class="clave__titulo">Es gratuito</h2>
			<p>Solo podrían cobrarse las copias en papel, según su costo.</p>
		</li>
		<li class="clave">
			<h2 class="clave__titulo">No tenés que explicar para qué</h2>
			<p>Cualquier persona puede pedir información sin decir el motivo ni tener abogado.</p>
		</li>
		<li class="clave">
			<h2 class="clave__titulo">15 días hábiles</h2>
			<p>Es el plazo para responderte. Puede extenderse otros 15 si hay una razón fundada.</p>
		</li>
	</ul>

	<div class="solicitud-grilla">
		<FormularioSolicitud />

		<aside class="lateral" aria-labelledby="titulo-otras-vias">
			<h2 id="titulo-otras-vias" class="lateral__titulo">Otras formas de pedir información</h2>
			<dl class="lateral__datos">
				<dt>Por correo electrónico</dt>
				<dd>
					{datos.correo ? <a href={`mailto:${datos.correo}`}>{datos.correo}</a> : <Pendiente dato="correo" />}
					<span class="lateral__nota">
						Incluí tu nombre, DNI o CUIT, un correo de contacto y qué información pedís.
					</span>
				</dd>
				<dt>En persona</dt>
				<dd>
					{datos.lugarPresencial ?? <Pendiente dato="oficina y dirección" />}
					<span class="lateral__nota">Horario: {datos.horario ?? <Pendiente dato="horario" />}</span>
				</dd>
			</dl>

			<h2 class="lateral__titulo">Responsable de acceso a la información</h2>
			<p>{datos.responsable ?? <Pendiente dato="nombre y cargo (art. 30, Ley 27.275)" />}</p>

			<h2 class="lateral__titulo">Antes de pedir</h2>
			<p>Fijate si ya está publicada en las <a href="/">secciones del portal</a>: la vas a tener en el momento.</p>
		</aside>
	</div>

	{
		documentos.length > 0 && (
			<section class="documentos-seccion" aria-labelledby="titulo-documentos">
				<h2 id="titulo-documentos">Normativa sobre acceso a la información</h2>
				<ListaDocumentos documentos={documentos} nivel={3} />
			</section>
		)
	}
</Base>

<style>
	.aviso--pendientes {
		background: #fff3b0;
		border-left-color: #8a7400;
		margin-bottom: 1.5rem;
		max-width: none;
	}

	.aviso--pendientes ul {
		margin: 0.35rem 0 0;
		padding-left: 1.2rem;
		font-size: 0.95rem;
	}

	.bajada {
		font-size: 1.15rem;
	}

	/* --- Tres datos clave --- */
	.claves {
		list-style: none;
		margin: 1.75rem 0 2.5rem;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
	}

	.clave {
		background: var(--fondo-alterno);
		border-top: 4px solid var(--azul);
		border-radius: 0 0 var(--radio) var(--radio);
		padding: 1rem 1.15rem;
	}

	.clave__titulo {
		font-size: 1.2rem;
		color: var(--azul);
		margin-bottom: 0.25rem;
	}

	.clave p {
		margin: 0;
		font-size: 0.95rem;
	}

	/* --- Formulario + columna lateral: en celular, la lateral va debajo --- */
	.solicitud-grilla {
		display: grid;
		gap: 2.5rem;
	}

	@media (min-width: 62rem) {
		.solicitud-grilla {
			grid-template-columns: minmax(0, 1fr) 20rem;
			align-items: start;
		}

		/* Queda a la vista mientras se completa el formulario */
		.lateral {
			position: sticky;
			top: 1.5rem;
		}
	}

	.lateral {
		background: var(--fondo-alterno);
		border-left: 4px solid var(--bordo);
		border-radius: 0 var(--radio) var(--radio) 0;
		padding: 1.25rem;
		font-size: 0.95rem;
	}

	.lateral__titulo {
		font-size: 1.1rem;
		margin-top: 1.25rem;
	}

	.lateral__titulo:first-child {
		margin-top: 0;
	}

	.lateral__datos {
		margin: 0 0 1rem;
	}

	.lateral__datos dt {
		font-weight: 600;
		color: var(--texto-titulo);
		margin-top: 0.6rem;
	}

	.lateral__datos dd {
		margin: 0.1rem 0 0;
	}

	.lateral__nota {
		display: block;
		font-size: 0.9rem;
		color: var(--texto-suave);
	}

	.documentos-seccion {
		margin-top: 3rem;
	}
</style>
