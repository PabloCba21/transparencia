---
import Base from '../layouts/Base.astro';
import { secciones } from '../data/secciones';
import { contenidoDeSeccion, validarArchivosDeSecciones } from '../lib/documentos';
import { formatearFechaCorta } from '../lib/fechas';

await validarArchivosDeSecciones();

// Estado de cada sección para mostrarlo en su tarjeta
const tarjetas = await Promise.all(
	secciones.map(async (seccion) => ({ seccion, contenido: await contenidoDeSeccion(seccion.slug) })),
);

const descripcion =
	'Información pública sobre el manejo de fondos de la Universidad Nacional de La Rioja: presupuesto, ejecución, compras, convenios, auditorías y normativa.';
---

<Base titulo="Inicio" descripcion={descripcion}>
	<div class="texto-lectura">
		<h1>Portal de Transparencia</h1>
		<p>
			La Universidad Nacional de La Rioja publica en este portal información sobre el manejo de sus
			fondos, para que cualquier persona pueda consultarla sin necesidad de pedirla.
		</p>
		<p>
			Las secciones se actualizan a medida que las áreas responsables entregan la información. Si lo
			que buscás no está publicado, podés solicitarlo: en <a href="/acceso-a-la-informacion/"
				>Acceso a la información pública</a
			> se explica cómo hacerlo.
		</p>
	</div>

	<h2 class="visualmente-oculto" id="secciones">Secciones</h2>
	<ul class="grilla" aria-labelledby="secciones">
		{
			tarjetas.map(({ seccion, contenido }) => (
				<li class="tarjeta">
					<h2>
						<a href={`/${seccion.slug}/`}>{seccion.titulo}</a>
					</h2>
					<p>{seccion.descripcion}</p>
					{/* Estado de la sección: la persona sabe si vale la pena entrar antes de hacer clic */}
					<p class="tarjeta__estado">
						{contenido.documentos.length === 0 ? (
							// Una sección con contenido propio (texto, formulario) no está
							// "en proceso": lo que no tiene es lista de documentos.
							seccion.contenidoPropio ? (
								<>Información disponible</>
							) : (
								<>En proceso de actualización</>
							)
						) : (
							<>
								{contenido.documentos.length} {contenido.documentos.length === 1 ? 'documento' : 'documentos'} ·
								Actualizado el <time datetime={contenido.ultimaActualizacion}>{formatearFechaCorta(contenido.ultimaActualizacion)}</time>
							</>
						)}
					</p>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.texto-lectura {
		margin-bottom: 2.5rem;
	}

	/* Título que existe para el lector de pantalla pero no se muestra:
	   le da nombre a la lista de secciones sin repetirlo visualmente. */
	.visualmente-oculto {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
