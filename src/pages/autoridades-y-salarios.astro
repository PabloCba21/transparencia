---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ListaDocumentos from '../components/ListaDocumentos.astro';
import { secciones } from '../data/secciones';
import { actualizado, rectora, secretarias, vicerrector } from '../data/autoridades';
import { contenidoDeSeccion } from '../lib/documentos';
import { formatearFecha } from '../lib/fechas';
import fotoRectora from '../assets/autoridades/rectora.jpg';
import fotoVicerrector from '../assets/autoridades/vicerrector.jpg';

const SLUG = 'autoridades-y-salarios';
const seccion = secciones.find((s) => s.slug === SLUG)!;
const { documentos, ultimaActualizacion } = await contenidoDeSeccion(SLUG);

// Astro genera las versiones optimizadas de cada foto en el build: sirve WebP
// y el tamaño que corresponda a cada pantalla, sin pedirle al celular la grande.
const superiores = [
	{ ...rectora, foto: fotoRectora },
	{ ...vicerrector, foto: fotoVicerrector },
];
---

<Base titulo={seccion.titulo} descripcion={seccion.descripcion} slugActivo={SLUG}>
	<p class="migas">
		<a href="/">Inicio</a>
		<span aria-hidden="true">›</span>
		<span>{seccion.titulo}</span>
	</p>

	<div class="texto-lectura">
		<h1>{seccion.titulo}</h1>
		<p>{seccion.descripcion}</p>
	</div>

	<h2 class="bloque-titulo">Autoridades</h2>

	<ul class="superiores">
		{
			superiores.map((autoridad) => (
				<li class="superior">
					<Image
						class="superior__foto"
						src={autoridad.foto}
						{/* El cargo y el nombre ya están como texto al lado, así que el alt
						    solo dice qué es la imagen y a quién muestra */}
						alt={`Retrato de ${autoridad.nombre}`}
						widths={[280, 395]}
						sizes="(min-width: 48rem) 17rem, 45vw"
					/>
					<p class="superior__cargo">{autoridad.cargo}</p>
					<p class="superior__nombre">{autoridad.nombre}</p>
				</li>
			))
		}
	</ul>

	<h2 class="bloque-titulo">Secretarías</h2>

	{/* Todas con el mismo peso visual: ninguna secretaría está por encima de otra */}
	<ul class="secretarias">
		{
			secretarias.map((autoridad) => (
				<li class="secretaria">
					<p class="secretaria__cargo">{autoridad.cargo}</p>
					<p class="secretaria__nombre">{autoridad.nombre}</p>
				</li>
			))
		}
	</ul>

	<p class="actualizacion">
		Nómina verificada al <time datetime={actualizado}>{formatearFecha(actualizado)}</time>.
	</p>

	{
		documentos.length > 0 && (
			<section class="documentos-seccion" aria-labelledby="titulo-documentos">
				<h2 id="titulo-documentos" class="bloque-titulo">
					Documentos
				</h2>
				<p class="actualizacion">
					Última actualización:{' '}
					<time datetime={ultimaActualizacion}>{formatearFecha(ultimaActualizacion)}</time>
				</p>
				<ListaDocumentos documentos={documentos} nivel={3} />
			</section>
		)
	}
</Base>

<style>
	.bloque-titulo {
		font-size: 1.5rem;
		margin-top: 2.5rem;
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--azul);
		max-width: 52rem;
	}

	/* --- Rectora y vicerrector --------------------------------------------
	   La jerarquía se marca con el tamaño y con la franja azul superior, no
	   solo con la foto: también se percibe sin distinguir bien los colores. */
	.superiores {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 17rem));
	}

	.superior {
		border: 1px solid var(--borde);
		border-top: 4px solid var(--azul);
		border-radius: 0 0 var(--radio) var(--radio);
		overflow: hidden;
		background: var(--fondo);
	}

	.superior__foto {
		display: block;
		width: 100%;
		height: auto;
		/* La proporción de los retratos institucionales: así no se recorta nada
		   y las dos tarjetas quedan de la misma altura aunque las fotos difieran
		   en unos píxeles. */
		aspect-ratio: 69 / 100;
		object-fit: cover;
		object-position: center top;
		background: var(--fondo-alterno);
	}

	.superior__cargo {
		margin: 0.9rem 1rem 0;
		font-family: var(--tipo-titulos);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--azul);
	}

	.superior__nombre {
		margin: 0.1rem 1rem 1rem;
		font-size: 1.05rem;
		color: var(--texto-titulo);
	}

	/* --- Secretarías -------------------------------------------------------
	   Son doce: en grilla se escanean por cargo, que es como se las busca. */
	.secretarias {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
		max-width: 52rem;
	}

	.secretaria {
		border-left: 3px solid var(--borde);
		padding: 0.15rem 0 0.15rem 0.9rem;
	}

	.secretaria__cargo {
		margin: 0;
		font-weight: 600;
		color: var(--texto-titulo);
		font-size: 0.95rem;
	}

	.secretaria__nombre {
		margin: 0;
		color: var(--texto-suave);
	}

	.actualizacion {
		margin-top: 1.5rem;
	}

	.documentos-seccion {
		margin-top: 1rem;
	}
</style>
