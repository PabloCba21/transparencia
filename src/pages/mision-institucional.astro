---
import Base from '../layouts/Base.astro';
import { secciones } from '../data/secciones';
import { mision } from '../data/mision';

// Página propia (no la genera [seccion].astro): el contenido es texto
// institucional, no una lista de documentos. Ver PAGINAS_PROPIAS en esa página.
const SLUG = 'mision-institucional';
const seccion = secciones.find((s) => s.slug === SLUG)!;
---

<Base titulo={seccion.titulo} descripcion={seccion.descripcion} slugActivo={SLUG}>
	<p class="migas">
		<a href="/">Inicio</a>
		<span aria-hidden="true">›</span>
		<span>{seccion.titulo}</span>
	</p>

	<div class="texto-lectura">
		<h1>{seccion.titulo}</h1>
		<p>{seccion.descripcion}</p>
	</div>

	{
		mision.map((bloque) => (
			<section class="bloque texto-lectura">
				<h2>{bloque.titulo}</h2>
				{bloque.parrafos.map((parrafo) => (
					<p>{parrafo}</p>
				))}
				{bloque.items && (
					<ol class="fines">
						{bloque.items.map((item) => (
							<li>{item}</li>
						))}
					</ol>
				)}
				{/* La cita de la norma va dentro del bloque que fundamenta */}
				<p class="fuente">Fuente: {bloque.fuente}</p>
			</section>
		))
	}
</Base>

<style>
	.bloque {
		margin-top: 2.5rem;
	}

	.bloque h2 {
		padding-bottom: 0.4rem;
		border-bottom: 2px solid var(--azul);
	}

	/* Lista numerada: los fines del Estatuto están enumerados en la norma,
	   así que el número es parte de la información, no decoración. */
	.fines {
		padding-left: 1.5rem;
	}

	.fines li {
		margin-bottom: 0.9rem;
		padding-left: 0.35rem;
	}

	.fuente {
		margin-top: 1.25rem;
		font-size: 0.9rem;
		color: var(--texto-suave);
		font-style: italic;
	}
</style>
