---
import Base from '../layouts/Base.astro';
import { secciones, type Seccion } from '../data/secciones';
import { formatearFecha } from '../lib/fechas';

// Una página estática por sección. Astro llama a esta función en el build y
// genera /presupuesto/index.html, /convenios/index.html, etc.
export function getStaticPaths() {
	return secciones.map((seccion) => ({
		params: { seccion: seccion.slug },
		props: { seccion },
	}));
}

interface Props {
	seccion: Seccion;
}

const { seccion } = Astro.props;
---

<Base titulo={seccion.titulo} descripcion={seccion.descripcion} slugActivo={seccion.slug}>
	<p class="migas">
		<a href="/">Inicio</a>
		<span aria-hidden="true">›</span>
		<span>{seccion.titulo}</span>
	</p>

	<div class="texto-lectura">
		<h1>{seccion.titulo}</h1>
		<p>{seccion.descripcion}</p>

		{
			seccion.actualizado === null ? (
				<p class="aviso">
					<strong>Información en proceso de actualización.</strong>
					<span class="aviso__fecha">
						Esta sección todavía no tiene contenido publicado. Mientras tanto, podés solicitar la
						información por la vía prevista en{' '}
						<a href="/acceso-a-la-informacion/">Acceso a la información pública</a>.
					</span>
				</p>
			) : (
				<p class="aviso__fecha">
					Última actualización: <time datetime={seccion.actualizado}>{formatearFecha(seccion.actualizado)}</time>
				</p>
			)
		}
	</div>
</Base>
