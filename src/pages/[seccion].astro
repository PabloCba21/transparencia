---
import Base from '../layouts/Base.astro';
import ListaDocumentos from '../components/ListaDocumentos.astro';
import { secciones, type Seccion } from '../data/secciones';
import { formatearFecha } from '../lib/fechas';
import { contenidoDeSeccion } from '../lib/documentos';

// Una página estática por sección. Astro llama a esta función en el build y
// genera /presupuesto/index.html, /convenios/index.html, etc.
export function getStaticPaths() {
	// Secciones que tienen su propia página en src/pages/ (si no se excluyen,
	// habría dos páginas para la misma URL). Va acá adentro porque Astro ejecuta
	// esta función aislada: solo ve lo importado, no las constantes del archivo.
	const PAGINAS_PROPIAS = new Set([
		'acceso-a-la-informacion',
		'autoridades-y-salarios',
		'mision-institucional',
	]);

	return secciones
		.filter((seccion) => !PAGINAS_PROPIAS.has(seccion.slug))
		.map((seccion) => ({
			params: { seccion: seccion.slug },
			props: { seccion },
		}));
}

interface Props {
	seccion: Seccion;
}

const { seccion } = Astro.props;
const { documentos, ultimaActualizacion } = await contenidoDeSeccion(seccion.slug);
---

<Base titulo={seccion.titulo} descripcion={seccion.descripcion} slugActivo={seccion.slug}>
	<p class="migas">
		<a href="/">Inicio</a>
		<span aria-hidden="true">›</span>
		<span>{seccion.titulo}</span>
	</p>

	<div class="texto-lectura">
		<h1>{seccion.titulo}</h1>
		<p>{seccion.descripcion}</p>

		{
			documentos.length === 0 ? (
				<p class="aviso">
					<strong>Información en proceso de actualización.</strong>
					<span class="aviso__fecha">
						Situación al <time datetime={ultimaActualizacion}>{formatearFecha(ultimaActualizacion)}</time>.
						Mientras tanto, podés solicitar la información por la vía prevista en{' '}
						<a href="/acceso-a-la-informacion/">Acceso a la información pública</a>.
					</span>
				</p>
			) : (
				<p class="actualizacion">
					Última actualización:{' '}
					<time datetime={ultimaActualizacion}>{formatearFecha(ultimaActualizacion)}</time>
				</p>
			)
		}
	</div>

	<ListaDocumentos documentos={documentos} />
</Base>
