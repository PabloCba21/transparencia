---
import Base from '../layouts/Base.astro';
import { secciones, type Seccion } from '../data/secciones';
import { formatearFecha } from '../lib/fechas';
import { agruparPorAnio, contenidoDeSeccion, formatearTamano } from '../lib/documentos';

// Una página estática por sección. Astro llama a esta función en el build y
// genera /presupuesto/index.html, /convenios/index.html, etc.
export function getStaticPaths() {
	return secciones.map((seccion) => ({
		params: { seccion: seccion.slug },
		props: { seccion },
	}));
}

interface Props {
	seccion: Seccion;
}

const { seccion } = Astro.props;
const { documentos, ultimaActualizacion } = await contenidoDeSeccion(seccion.slug);
const grupos = agruparPorAnio(documentos);
---

<Base titulo={seccion.titulo} descripcion={seccion.descripcion} slugActivo={seccion.slug}>
	<p class="migas">
		<a href="/">Inicio</a>
		<span aria-hidden="true">›</span>
		<span>{seccion.titulo}</span>
	</p>

	<div class="texto-lectura">
		<h1>{seccion.titulo}</h1>
		<p>{seccion.descripcion}</p>

		{
			documentos.length === 0 ? (
				<p class="aviso">
					<strong>Información en proceso de actualización.</strong>
					<span class="aviso__fecha">
						Situación al <time datetime={ultimaActualizacion}>{formatearFecha(ultimaActualizacion)}</time>.
						Mientras tanto, podés solicitar la información por la vía prevista en{' '}
						<a href="/acceso-a-la-informacion/">Acceso a la información pública</a>.
					</span>
				</p>
			) : (
				<p class="actualizacion">
					Última actualización:{' '}
					<time datetime={ultimaActualizacion}>{formatearFecha(ultimaActualizacion)}</time>
				</p>
			)
		}
	</div>

	{
		grupos.map(([anio, docs]) => (
			<section class="anio" aria-labelledby={`anio-${anio}`}>
				<h2 id={`anio-${anio}`}>{anio}</h2>
				<ul class="documentos">
					{docs.map((doc) => (
						<li class="documento">
							{/* El formato y el tamaño van DENTRO del link: el lector de pantalla
							    anuncia qué se va a abrir antes de hacer clic (WCAG 2.4.4) */}
							<a class="documento__titulo" href={doc.url}>
								{doc.titulo}{' '}
								<span class="documento__archivo">(PDF, {formatearTamano(doc.bytes)})</span>
							</a>
							{doc.descripcion && <p class="documento__descripcion">{doc.descripcion}</p>}
							<p class="documento__meta">
								<span>{doc.tipo}</span>
								<span>
									<time datetime={doc.fecha}>{formatearFecha(doc.fecha)}</time>
								</span>
								{doc.expediente && <span>Expte. {doc.expediente}</span>}
							</p>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Base>
